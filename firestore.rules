rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Único documento de datos de la app ────────────────────────────────────
    // Solo los UIDs registrados en USER_MAP (Javi y Lali) pueden leer y escribir.
    // Nadie más — ni siquiera usuarios autenticados con otras cuentas Google.
    match /appdata/main {
      allow read, write: if request.auth != null
                         && request.auth.uid in [
                              'h0FlnAU3wabBCTztmPXdLyFW6R42',   // ← reemplazá con el UID real de Javi
                              'JjDJiAjLmVSc0WODsfvULRLT59s2'    // ← reemplazá con el UID real de Lali
                            ];
    }

    // Bloquear cualquier otro documento o colección
    match /{document=**} {
      allow read, write: if false;
    }
  }
}