rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Acceso exclusivo para Javi y Lali ─────────────────────────────────────
    // Estos UIDs deben coincidir con USER_MAP en src/constants.ts.
    // Nadie más tiene acceso — ni siquiera usuarios autenticados con otras
    // cuentas de Google.
    function isCouple() {
      return request.auth != null
        && request.auth.uid in [
             'h0FlnAU3wabBCTztmPXdLyFW6R42',   // Javi
             'JjDJiAjLmVSc0WODsfvULRLT59s2'    // Lali
           ];
    }

    // ── Privacidad de gastos (Sprint 11) ──────────────────────────────────────
    // Un gasto privado (visibilidad == 'privado') solo lo ve/edita su dueño
    // (ownerId == uid). Un gasto compartido lo ven ambos. Se usa != 'privado'
    // (no == 'compartido') a propósito: un doc sin el campo se trata como
    // compartido → nunca queda inaccesible por falta de migración.
    function canSee(d) {
      return d.visibilidad != 'privado' || d.ownerId == request.auth.uid;
    }
    function canOwn(d) {
      return d.visibilidad != 'privado' || d.ownerId == request.auth.uid;
    }
    // Nota (hardening futuro): hoy un miembro podría convertir un gasto compartido
    // en privado y "ocultárselo" al otro. Aceptable entre pareja; se endurece si
    // hace falta comparando resource.data.visibilidad con request.resource.data.

    // ── Colecciones de la app ─────────────────────────────────────────────────
    match /expenses/{id} {
      allow read:           if isCouple() && canSee(resource.data);
      allow create:         if isCouple() && canOwn(request.resource.data);
      allow update:         if isCouple() && canSee(resource.data) && canOwn(request.resource.data);
      // En delete NO existe request.resource (dato entrante) → nunca se llama a
      // canOwn(null). Basta con poder VER el doc: un privado solo lo borra su dueño.
      allow delete:         if isCouple() && canSee(resource.data);
    }
    match /plans/{id} {
      allow read:           if isCouple() && canSee(resource.data);
      allow create:         if isCouple() && canOwn(request.resource.data);
      allow update:         if isCouple() && canSee(resource.data) && canOwn(request.resource.data);
      // En delete NO existe request.resource (dato entrante) → nunca se llama a
      // canOwn(null). Basta con poder VER el doc: un privado solo lo borra su dueño.
      allow delete:         if isCouple() && canSee(resource.data);
    }
    match /payments/{id}        { allow read, write: if isCouple(); }
    match /settings/{id}        { allow read, write: if isCouple(); }
    match /userPreferences/{id} { allow read, write: if isCouple(); }
    match /activityLog/{id}     { allow read, write: if isCouple(); }

    // Documento legacy — runMigrationIfNeeded() lo lee y borra si aún existe.
    // Se puede eliminar este bloque cuando se retire la migración del código.
    match /appdata/main         { allow read, write: if isCouple(); }

    // ── Bloquear cualquier otro documento o colección ─────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
